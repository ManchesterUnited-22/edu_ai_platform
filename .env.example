PORT=8000

# --- Gemini ---
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- RAG ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
CONFIDENCE_THRESHOLD=0.65

# --- Database ---
DATABASE_URL=postgresql://edu:edu@postgres:5432/edu_ai
CHROMA_URL=http://chroma:8000
# Bật graph (gợi ý ôn tập theo tiên quyết). Tắt thì RAG vẫn chạy bình thường
GRAPH_ENABLED=false
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=edu_password

# --- Auth ---
JWT_SECRET=change_me
JWT_EXPIRES_IN=1h
# Tùy chọn: tạo tài khoản admin khi chạy seed (không dùng mật khẩu mặc định)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị viên

# --- Giới hạn ---
PRACTICE_QUIZ_PER_DAY=5
QA_PER_MINUTE=10
OFFICIAL_QUIZ_MAX_ATTEMPTS=2
LINK_CODE_TTL_MINUTES=30
MAX_UPLOAD_MB=20
ALERT_ENABLED=true
ALERT_CRON=0 7 * * *
ALERT_INACTIVE_DAYS=7
ALERT_SCORE_DROP=1.5
ALERT_LOW_SCORE=5
